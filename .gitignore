# PDF files
*.pdf

# Kaggle: keep the kernel manifest local since it carries the user's
# Kaggle username and the kernel's private/public flag. Ship the template
# (kernel-metadata.template.json) instead so anyone cloning the repo can
# fill in their own values.
scripts/kaggle/kernel-metadata.json

# Kaggle API tokens. NEVER commit these. The CLI reads them from
# ~/.kaggle/kaggle.json; a stray copy anywhere under the repo would leak.
kaggle.json
**/kaggle.json
# But the manifest template is the one file we DO want tracked here.
!scripts/kaggle/kernel-metadata.template.json
kaggle_v4_pulled/
# Any directory we use to stage outputs pulled back from a Kaggle kernel run.
# These contain 1+ GB of checkpoints and the kernel build artifacts.
kaggle_outputs*/
